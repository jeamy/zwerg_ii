/* Global application styles (Qt Style Sheet)
 * Control Deck / dock panels
 */

QDockWidget {
    background-color: #2D2D30;
}

QDockWidget::title {
    background-color: #2D2D30;
    color: #E0E0E0;
    padding: 4px;
}

/* Status label styling */
QLabel#statusLabel {
    font-weight: bold;
}

/* Error/cancelled/disconnected states (red) */
QLabel#statusLabel[status="disconnected"],
QLabel#statusLabel[status="cancelled"],
QLabel#statusLabel[status="noDevices"] {
    color: #FF5555;
}

/* Warning states (orange) */
QLabel#statusLabel[status="scanning"],
QLabel#statusLabel[status="connecting"] {
    color: #FFA500;
}

/* OK state (green) */
QLabel#statusLabel[status="ok"] {
    color: #55FF55;
}

/* Critical error state (bright red) */
QLabel#statusLabel[status="error"] {
    color: #FF0000;
}

/* Stream views */
QLabel#mainStreamView {
    background-color: #202020;
    border: 1px solid #444444;
    color: #CCCCCC;
}

QLabel#pipStreamView {
    background-color: #202020;
    border: 1px solid #666666;
    color: #CCCCCC;
}

QLabel#pipStreamView:hover {
    border-color: #AAAAAA;
}

/* Camera Settings Panel */
CameraSettingsPanel QPushButton#photoButton,
CameraSettingsPanel QPushButton#recButton {
    background-color: #7f8c8d;
    color: white;
    font-weight: bold;
    border-radius: 4px;
}

CameraSettingsPanel QPushButton#photoButton:hover,
CameraSettingsPanel QPushButton#recButton:hover {
    background-color: #95a5a6;
}

CameraSettingsPanel QPushButton#recButton:disabled {
    background-color: #555555;
    color: #888888;
}

CameraSettingsPanel QGroupBox {
    font-weight: bold;
    border: 1px solid #555555;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
}

CameraSettingsPanel QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #3498db;
}

CameraSettingsPanel QSlider::groove:horizontal {
    border: 1px solid #444444;
    height: 6px;
    background: #333333;
    border-radius: 3px;
}

CameraSettingsPanel QSlider::handle:horizontal {
    background: #3498db;
    border: 1px solid #2980b9;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

CameraSettingsPanel QSlider::handle:horizontal:hover {
    background: #5dade2;
}

CameraSettingsPanel QSlider::handle:horizontal:disabled {
    background: #555555;
}

CameraSettingsPanel QSlider::sub-page:horizontal:disabled {
    background: #555555;
}

CameraSettingsPanel QSlider::sub-page:horizontal {
    background: #3498db;
    border-radius: 3px;
}

CameraSettingsPanel QLabel {
    color: #E0E0E0;
}
